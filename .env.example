# Copy this file to `.env.local` and fill in the values you need.
# Every variable is optional: with nothing set, the app runs in local demo mode.

# --- Firebase Authentication (optional) --------------------------------------
# From Firebase console > Project settings > Your apps > Web app config.
# When these are set, real Email/Password sign-in replaces demo mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated emails allowed into the Supervisor Portal (Firebase mode only).
NEXT_PUBLIC_SUPERVISOR_EMAILS=

# Supervisor name shown on the student dashboard.
NEXT_PUBLIC_SUPERVISOR_NAME=

# --- Google Gemini (optional, server-side only) -----------------------------
# Enables the "Ask Gemini" buttons. Get a key at https://aistudio.google.com/apikey
# Never prefix this with NEXT_PUBLIC_ - it must stay on the server.
GEMINI_API_KEY=
# Defaults to gemini-flash-latest.
GEMINI_MODEL=

# --- Hex Sentinel Lite honeypot traps ----------------------------------------
# Set to "false" to disable trap logging.
HEX_SENTINEL_ENABLED=true
# Optional HTTPS webhook (e.g. Slack/Discord/Teams incoming webhook) for real-time alerts.
# Alerts are throttled to 1 per IP and 20 in total per minute.
HEX_SENTINEL_WEBHOOK_URL=
